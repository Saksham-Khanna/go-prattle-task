# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development, and set the same
# variable in the Vercel project settings for the deployed frontend.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Express + MongoDB API -------------------------------------------------
# REQUIRED. Full URL of the deployed Express backend, including the /api path.
# The frontend has no embedded API routes and no database credentials.
# See backend/.env.example for the backend variables.
#
# Local:
NEXT_PUBLIC_API_URL=http://localhost:5000/api
#
# Production (Render):
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api
