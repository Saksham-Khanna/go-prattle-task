# ---------------------------------------------------------------------------
# Copy this file to `.env.local` (local dev) and set the same variables in the
# Vercel project settings for the deployed app. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Embedded API (Next.js route handlers) --------------------------------
# REQUIRED. PostgreSQL connection string used by the embedded API
# (src/app/api/*). This is the only variable the deployed app needs.
#
# Free hosted options: Neon (https://neon.tech) or Supabase.
# Neon gives a string like:
#   postgresql://<user>:<password>@ep-xxxxx.<region>.aws.neon.tech/<db>?sslmode=require
# Local Postgres fallback:
#   postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Optional: standalone Express + MongoDB backend -----------------------
# Leave unset to use the embedded API (relative /api).
# Set this only if you deploy `backend/` separately and want the frontend to
# talk to it instead. See backend/.env.example.
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api
# NEXT_PUBLIC_API_URL=
