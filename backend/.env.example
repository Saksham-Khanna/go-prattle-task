# --- Backend (Express) ----------------------------------------------------

# Port the API listens on
PORT=5000

# MongoDB connection string (local MongoDB or MongoDB Atlas).
# Atlas example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/gopratle-events
MONGODB_URI=mongodb://127.0.0.1:27017/gopratle-events

# Origin of the frontend (used for CORS). Add more origins in
# src/app.ts if you deploy to several hosts.
FRONTEND_URL=http://localhost:3000

# development | test | production
NODE_ENV=development
